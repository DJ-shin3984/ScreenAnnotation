<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ScreenAnnotation.Core/ScreenAnnotation.Core.csproj" />
    <!-- 기능별 하위 폴더의 NativeMethods.txt도 CsWin32가 읽는다 -->
    <AdditionalFiles Include="**/NativeMethods.txt" Exclude="NativeMethods.txt;bin/**;obj/**" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
  </ItemGroup>
</Project>
